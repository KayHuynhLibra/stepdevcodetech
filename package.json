{
  "name": "sofiaore-tarot-demo",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "demo": "concurrently -n server,client -c magenta,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "migrate:scale10": "node server/scripts/migrate-scale-div10.mjs",
    "backup:data": "node server/scripts/backup-data.mjs",
    "install:all": "npm install",
    "redeploy": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/redeploy.ps1",
    "redeploy:help": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/redeploy.ps1 -Action help",
    "redeploy:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/redeploy.ps1 -Action check",
    "redeploy:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/redeploy.ps1 -Action deploy",
    "redeploy:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/redeploy.ps1 -Action verify",
    "redeploy:full": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/redeploy.ps1 -Action full",
    "redeploy:sh": "bash ./scripts/redeploy.sh",
    "hackmyapp:live": "powershell -NoProfile -ExecutionPolicy Bypass -File ./hackmyapp/scripts/safe-check.ps1 -Target live",
    "hackmyapp:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./hackmyapp/scripts/safe-check.ps1 -Target local"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
