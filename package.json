{
  "name": "sofia-tarot-demo",
  "private": true,
  "version": "1.0.0",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "demo": "concurrently -n be,fe -c magenta,cyan \"npm run dev -w be\" \"npm run dev -w fe\"",
    "build": "npm run build -w fe",
    "start": "npm run start -w be",
    "migrate:scale10": "node be/scripts/migrate-scale-div10.mjs",
    "backup:data": "node be/scripts/backup-data.mjs",
    "backup:offsite": "node be/scripts/backup-offsite.mjs",
    "baseline:100x": "node be/scripts/baseline-100x.mjs",
    "db:migrate": "node be/scripts/db-migrate.mjs",
    "install:all": "npm install",
    "redeploy": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/redeploy.ps1",
    "redeploy:help": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/redeploy.ps1 -Action help",
    "redeploy:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/redeploy.ps1 -Action check",
    "redeploy:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/redeploy.ps1 -Action deploy",
    "redeploy:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/redeploy.ps1 -Action verify",
    "redeploy:full": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/redeploy.ps1 -Action full",
    "redeploy:sh": "bash ./scripts/redeploy.sh",
    "hackmyapp:live": "powershell -NoProfile -ExecutionPolicy Bypass -File ./local/hackmyapp/scripts/safe-check.ps1 -Target live",
    "hackmyapp:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./local/hackmyapp/scripts/safe-check.ps1 -Target local -LocalPort 3001"
  },
  "workspaces": [
    "be",
    "fe"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
