# Copy to .env at repo root or export in shell before `npm run start`
PORT=3001

# Voice / Live WebRTC — production: TURN required for many 4G/NAT (video especially).
# Rebuild FE after changing VITE_* (`npm run build -w fe`).
# VITE_TURN_URL=turn:your-turn.example:3478?transport=udp
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
